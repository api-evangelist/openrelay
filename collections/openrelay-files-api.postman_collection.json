      "name": "Files",
      "description": {
        "content": "Input and result files for the Batch API (JSONL, up to 200 MB and 50,000 records). Served by the inference endpoint (inference.openrelay.inc).\n",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "cc1e8943-41c6-4fd7-9db7-70eba86a3777",
          "name": "Upload a JSONL input file for the Batch API",
          "request": {
            "name": "Upload a JSONL input file for the Batch API",
            "description": {
              "content": "Send multipart/form-data with a `file` part (the JSONL bytes, up to 200 MB and 50,000 records) and a `purpose` field set to `batch`. Each line is one request object; the returned file id goes in `input_file_id` when creating a batch.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "files"
              ],
              "host": [
                "{{v1-files-Url}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "description": "(Required) The JSONL file contents."
                },
                {
                  "key": "purpose",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required)  (This can only be one of batch)"
                }
              ]
            }
          },
