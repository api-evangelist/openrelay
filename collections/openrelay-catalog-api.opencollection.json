{
  "opencollection": "1.0.0",
  "info": {
    "name": "OpenRelay Account Catalog API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Catalog",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GPU availability by model",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.openrelay.inc/v1/gpu-availability",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Live availability per GPU model. Responses are served from a short-lived cache."
        },
        {
          "info": {
            "name": "GPU model catalog",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.openrelay.inc/v1/gpu-models",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "GPU model catalog"
        },
        {
          "info": {
            "name": "Locations / regions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.openrelay.inc/v1/locations",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Locations / regions"
        },
        {
          "info": {
            "name": "List models in the OpenRelay catalog (OpenAI-compatible)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.openrelay.inc/v1/models",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the public model catalog. Free, not balance-gated. Models with status \"available\" can be used immediately in /v1/chat/completions; \"request_access\" models are listed for discovery but are not yet invocable.\n"
        },
        {
          "info": {
            "name": "GPU + CPU pricing",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.openrelay.inc/v1/pricing",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "GPU + CPU pricing"
        },
        {
          "info": {
            "name": "VM template catalog",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.openrelay.inc/v1/vm-templates",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "VM template catalog"
        }
      ]
    }
  ],
  "bundled": true
}