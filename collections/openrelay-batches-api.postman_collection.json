      "id": "7e413d06-e37d-4a82-8a5d-5e3ac000b979",
      "name": "Batches",
      "description": {
        "content": "Batch inference jobs: submit a JSONL file of requests, poll status, and download results at a discounted rate. Served by the inference endpoint (inference.openrelay.inc). Batch access is enabled per organization; without it these endpoints return 404.\n",
        "type": "text/plain"
      },
