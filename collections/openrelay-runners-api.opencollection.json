          "http": {
            "method": "POST",
            "url": "https://api.openrelay.inc/v1/orgs/:orgId/runner-pools",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a runner pool"
        },
        {
