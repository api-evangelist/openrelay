            "name": "List runner pools (with active/queued usage)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.openrelay.inc/v1/orgs/:orgId/runner-pools",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List runner pools (with active/queued usage)"
        },
        {
          "info": {
            "name": "Create a runner pool",
            "type": "http"
