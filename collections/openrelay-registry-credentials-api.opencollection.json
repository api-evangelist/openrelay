{
  "opencollection": "1.0.0",
  "info": {
    "name": "OpenRelay Account Registry Credentials API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Registry Credentials",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List an org's registry credentials (no secrets)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.openrelay.inc/v1/orgs/:orgId/registry-credentials",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List an org's registry credentials (no secrets)"
        },
        {
          "info": {
            "name": "Create a registry credential (credentials stored encrypted)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.openrelay.inc/v1/orgs/:orgId/registry-credentials/create",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a registry credential (credentials stored encrypted)"
        },
        {
          "info": {
            "name": "Delete a registry credential",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.openrelay.inc/v1/orgs/:orgId/registry-credentials/:id",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete a registry credential"
        }
      ]
    }
  ],
  "bundled": true
}