          "http": {
            "method": "POST",
            "url": "https://api.openrelay.inc/v1/vms/:id/ssh-keys",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Attach an org SSH key to a VM"
        },
        {
          "info": {
            "name": "Stop a VM",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.openrelay.inc/v1/vms/:id/stop",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Stop a VM"
        },
        {
          "info": {
            "name": "Get a VM's embedded Telegram link",
            "type": "http"
